              "y": null
            },
            "out_connectors": {
              "e": null
            },
            "guid": "6a1ec779-1f60-470e-8752-1123fd168494"
          },
          "id": 1,
          "scope_entry": null,
          "scope_exit": null
        },
        {
          "type": "Tasklet",
          "label": "fnn_layer1",
          "attributes": {
            "code": {
              "string_data": "for k in range(32):\n    acc = b[k]\n    for m in range(2):\n        acc += (W[k, m] * e[m])\n    out[k] = (acc if (acc > 0.0) else 0.0)",
              "language": "Python"
            },
            "debuginfo": {
