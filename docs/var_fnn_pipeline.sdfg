      "nodes": [
        {
          "type": "Tasklet",
          "label": "var_gemv",
          "attributes": {
            "code": {
              "string_data": "for i in range(2):\n    acc = c[i]\n    for j in range(4):\n        acc += (A[i, j] * v[j])\n    y[i] = acc",
              "language": "Python"
            },
            "debuginfo": {
              "type": "DebugInfo",
              "start_line": 29,
              "end_line": 29,
              "start_column": 0,
              "end_column": 0,
              "filename": "C:\\Users\\achyu\\quant_fpga_pipeline\\src\\prototype_sdfg.py"
            },
            "label": "var_gemv",
            "in_connectors": {
              "A": null,
              "c": null,
              "v": null
            },
            "out_connectors": {
              "y": null
            },
            "guid": "3cfcf35d-3e04-49da-9c26-da98f5402fd4"
          },
          "id": 0,
          "scope_entry": null,
          "scope_exit": null
        },
        {
          "type": "Tasklet",
          "label": "calc_residual",
          "attributes": {
            "code": {
              "string_data": "for i in range(2):\n    e[i] = (x[i] - y[i])",
              "language": "Python"
            },
            "debuginfo": {
              "type": "DebugInfo",
              "start_line": 43,
              "end_line": 43,
              "start_column": 0,
              "end_column": 0,
              "filename": "C:\\Users\\achyu\\quant_fpga_pipeline\\src\\prototype_sdfg.py"
            },
