      "nodes": [
        {
          "type": "Tasklet",
          "label": "var_core",
          "attributes": {
            "code": {
              "string_data": "\nfor (int i = 0; i < 2; i++) {\n    float sum = _c[i];\n    for (int j = 0; j < 4; j++) {\n        sum += _A[i * 4 + j] * _v[j];\n    }\n    _y_var[i] = sum;\n}\n",
              "language": "CPP"
            },
            "debuginfo": {
              "type": "DebugInfo",
              "start_line": 36,
              "end_line": 36,
              "start_column": 0,
              "end_column": 0,
              "filename": "C:\\Users\\achyu\\quant_fpga_pipeline\\src\\prototype_sdfg.py"
            },
            "label": "var_core",
            "in_connectors": {
              "_A": null,
              "_c": null,
              "_v": null
            },
            "out_connectors": {
              "_y_var": null
            },
            "guid": "7010601b-58e6-4df1-a37a-ec9f63c36f6d"
          },
          "id": 0,
          "scope_entry": null,
          "scope_exit": null
        },
        {
          "type": "Tasklet",
          "label": "res_formation",
          "attributes": {
            "code": {
              "string_data": "\nfor (int i = 0; i < 2; i++) {\n    _eps[i] = _x[i] - _y_var[i];\n}\n",
              "language": "CPP"
            },
            "debuginfo": {
              "type": "DebugInfo",
              "start_line": 53,
              "end_line": 53,
              "start_column": 0,
