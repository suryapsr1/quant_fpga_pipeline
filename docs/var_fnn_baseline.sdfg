          },
          "id": 1,
          "scope_entry": null,
          "scope_exit": null
        },
        {
          "type": "Tasklet",
          "label": "fnn_layer1",
          "attributes": {
            "code": {
              "string_data": "\nfor (int k = 0; k < 32; k++) {\n    float z = _b1[k];\n    for (int m = 0; m < 2; m++) {\n        z += _W1[k * 2 + m] * _eps[m];\n    }\n    _out[k] = (z > 0.0f) ? z : 0.0f;\n}\n",
              "language": "CPP"
            },
            "debuginfo": {
